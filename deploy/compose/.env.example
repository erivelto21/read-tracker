# Copy this file to .env and fill in the values.
#
# .env holds NON-SECRET configuration only. Secrets (MongoDB passwords, the
# Basic Auth credentials, and the registry credentials) live in .env.secret.yaml,
# encrypted with SOPS, and are merged into the VM's .env by
# scripts/app-vm-deploy.sh at deploy time.

# ── Registry ──────────────────────────────────────────────────────────────────
REGISTRY=container-registry.br-se1.magalu.cloud
REGISTRY_NAMESPACE=my-register

# ── Image tags ────────────────────────────────────────────────────────────────
# Short commit SHA of the revision each image was built from.
# Generate with: git rev-parse --short HEAD
# NEVER use "latest" here — production must not drift on an image pull.
API_TAG=
FRONT_TAG=

# ── Application ───────────────────────────────────────────────────────────────
DB_NAME=read_tracker
API_PORT=8080

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Username only; both passwords come from .env.secret.yaml.
MONGO_ROOT_USER=root