# Multi-stage Dockerfile for the read-tracker frontend
# Stage 1: build the React app
# Stage 2: serve the static output with nginx

FROM node:22-alpine AS builder

WORKDIR /app
COPY front/package.json front/package-lock.json ./
RUN npm ci

COPY front/ ./
RUN npm run build


FROM nginx:1.27-alpine AS runtime

LABEL org.opencontainers.image.title="read-tracker-front" \
      org.opencontainers.image.description="React frontend served by nginx" \
      org.opencontainers.image.authors="erivelto"

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
