# Multi-stage Dockerfile for nightcrawler
# TODO: implement when nightcrawler source is ready

FROM golang:1.25-alpine AS builder
RUN apk add --no-cache git

WORKDIR /src
COPY nightcrawler/go.mod nightcrawler/go.sum /src/nightcrawler/
WORKDIR /src/nightcrawler
RUN go mod download

COPY nightcrawler/ /src/nightcrawler/
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags "-s -w" -o /out/nightcrawler ./cmd/...


FROM alpine:3.18 AS runtime
LABEL org.opencontainers.image.title="nightcrawler" \
      org.opencontainers.image.description="Crawler for fetching new chapters" \
      org.opencontainers.image.authors="erivelto"

RUN apk add --no-cache ca-certificates && \
    addgroup -S app && adduser -S app -G app

WORKDIR /app
COPY --from=builder /out/nightcrawler /app/nightcrawler
RUN chown app:app /app/nightcrawler

USER app
CMD ["./nightcrawler"]
